                                "{{baseUrl}}"
                            ],
                            "path": [
                                "company",
                                "kyc-one",
                                "admin",
                                "private",
                                "level-1",
                                "{{companyId}}",
                                "company-profile"
                            ]
                        },
                        "description": "Get company profile section (name, type, address, contact info)"
                    },
                    "response": []
