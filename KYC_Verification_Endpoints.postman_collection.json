{
    "info": {
        "name": "KYC Verification Endpoints",
        "description": "Collection for testing Admin KYC verification endpoints",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8088/api/v1",
            "type": "string"
        },
        {
            "key": "companyId",
            "value": "YOUR_COMPANY_ID_HERE",
            "type": "string"
        },
        {
            "key": "adminToken",
            "value": "YOUR_ADMIN_JWT_TOKEN_HERE",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "KYC Overview",
            "item": [
                {
                    "name": "Get KYC Overview",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/company/kyc-one/admin/private/get/{{companyId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "company",
                                "kyc-one",
                                "admin",
                                "private",
                                "get",
                                "{{companyId}}"
                            ]
                        },
                        "description": "Get KYC overview with company name, user ID, and status badges for user, level 1, and level 2"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "KYC Level 1",
            "item": [
                {
                    "name": "1. Get Company Profile",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
